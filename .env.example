# URL base da API de Estoque (FastAPI implantada na Cloud)
STOCK_API_BASE_URL=http://150.136.45.59:8082

# URL do Webhook do n8n na Cloud para notificações/alertas de estoque
# Para testes com 'Listen for test event', use /webhook-test/alerta-estoque
# Para produção (workflow ativo), use /webhook/alerta-estoque
N8N_WEBHOOK_URL=http://150.136.45.59:5678/webhook/alerta-estoque

# Configurações de e-mail para os alertas disparados no n8n
ALERT_EMAIL_TO=rsc_sc@hotmail.com
ALERT_EMAIL_FROM=rafaeldossantoscunha@gmail.com
ALERT_SENDER_NAME=StockFlow Bot

# Chave de API da LLM (Google Gemini ou OpenAI)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# (Opcional) Provedor OpenAI caso utilize GPT
OPENAI_API_KEY=sua_chave_openai_aqui

# Provedor padrão: gemini ou openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
